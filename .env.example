# Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (live keys in Production, test keys elsewhere)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...

# Shared secret that protects /api/cron/match-sweep (Vercel sends it as a Bearer token)
CRON_SECRET=a-long-random-string

# Public site URL, used for Stripe redirects when no Origin header is present
NEXT_PUBLIC_APP_URL=https://www.coachinmind.com.au
